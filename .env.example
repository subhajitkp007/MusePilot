# ==============================================================================
# MusePilot Environment Configuration Template
# Copy this file to `.env` and populate your API keys.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- 1. Meta Model API (SAM 3.1, Muse Spark, Muse Voice Transcribe) ---
MUSEPILOT_META_API_KEY=your_meta_model_api_key_here
MUSEPILOT_META_API_BASE_URL=https://api.meta.ai/v1
MUSEPILOT_SAM_MODEL_ID=meta-models/sam-3.1
MUSEPILOT_PLANNER_MODEL_ID=meta-models/muse-spark
MUSEPILOT_PLANNER_TEMPERATURE=0.1
MUSEPILOT_VOICE_MODEL_ID=meta-models/muse-voice-transcribe

# --- 2. Partner Inference Open-Weight Verifier ($10K Bonus Qualification) ---
# Supported Providers: baseten | modal | fireworks
MUSEPILOT_PARTNER_PROVIDER=baseten
MUSEPILOT_PARTNER_API_KEY=your_partner_inference_api_key_here
MUSEPILOT_PARTNER_BASE_URL=https://inference.baseten.co/v1
# Official Hackathon Tag per Baseten/Meta Instructions:
MUSEPILOT_VERIFIER_MODEL_ID=meta-models/muse-spark-open-1026
MUSEPILOT_VERIFIER_MIN_ROI_PIXEL_DELTA=0.015
MUSEPILOT_VERIFIER_CONFIDENCE_THRESHOLD=0.80

# --- 3. Execution, Display & Safety Guardrails ---
# Physical-to-logical pixel ratio (e.g., 2.0 for macOS Retina, 1.0 for standard 1080p)
MUSEPILOT_DISPLAY_DPI_SCALE=2.0
MUSEPILOT_EXECUTION_MODE=simulated
MUSEPILOT_MAX_RETRIES_PER_STEP=2
MUSEPILOT_ADB_SERIAL=
MUSEPILOT_ALLOW_REPLAN_ON_OBSTRUCTION=true
MUSEPILOT_API_TIMEOUT_SECONDS=15.0
MUSEPILOT_REQUIRE_DESTRUCTIVE_CONFIRMATION=true
# Optional: point at a custom YAML defaults file (default: configs/default_config.yaml)
# MUSEPILOT_CONFIG_YAML_PATH=./configs/default_config.yaml

# --- 4. Telemetry, Logging & Observability ---
MUSEPILOT_LOG_LEVEL=INFO
MUSEPILOT_LOG_FORMAT=json
MUSEPILOT_TELEMETRY_ENABLED=true
MUSEPILOT_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
MUSEPILOT_TRACE_DIR=./traces
MUSEPILOT_LOG_DIR=./logs

